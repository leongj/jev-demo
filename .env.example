# Server only. Never use NEXT_PUBLIC_ for credentials.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-GPT-6-LUNA-DEPLOYMENT
# Exact underlying model, not an arbitrary deployment alias.
# Only the documented Luna models below are permitted for reasoning:none.
AZURE_OPENAI_MODEL=gpt-6-luna
# entra uses DefaultAzureCredential (including az login); key is optional.
AZURE_OPENAI_AUTH=entra
AZURE_OPENAI_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Optional USD/million overrides. GPT-6 Luna defaults: input 0.10, cached 0.01, output 0.50.
# Other Azure models still require explicit prices.
AZURE_INPUT_USD_PER_MILLION=
AZURE_CACHED_INPUT_USD_PER_MILLION=
AZURE_OUTPUT_USD_PER_MILLION=
# Published Jev 1.13 input price checked 2026-10-01; output is free.
JEV_INPUT_USD_PER_MILLION=0.042
